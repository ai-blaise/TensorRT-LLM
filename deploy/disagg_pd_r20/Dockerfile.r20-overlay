ARG BASE_IMAGE=local/dynamo-trtllm-optrt-custom:r20-nixl-layersplit-base
FROM ${BASE_IMAGE}
USER root

LABEL ai.blaise.r20-overlay="true"

ARG SITE_PACKAGES=/opt/dynamo/venv/lib/python3.12/site-packages

RUN /opt/dynamo/venv/bin/python -m pip install --no-cache-dir msgpack==1.1.1

# First-class LayerSplit CP support.  Keep this overlay ABI-conservative: the
# base r20 image carries the compiled TRT-LLM runtime and core distributed
# Python surfaces; replacing communicator/model/attention internals without a
# matching C++ rebuild can break executor creation.  The LayerSplit pieces below
# are the first-class config/mapping surface, the LayerSplit-aware executor
# guards, plus the request-merge and sparse runtime code that owns the custom
# behavior.
COPY --chown=dynamo:0 tensorrt_llm/mapping.py ${SITE_PACKAGES}/tensorrt_llm/mapping.py
COPY --chown=dynamo:0 tensorrt_llm/_torch/pyexecutor/request_utils.py ${SITE_PACKAGES}/tensorrt_llm/_torch/pyexecutor/request_utils.py
COPY --chown=dynamo:0 tensorrt_llm/_torch/pyexecutor/py_executor_creator.py ${SITE_PACKAGES}/tensorrt_llm/_torch/pyexecutor/py_executor_creator.py
COPY --chown=dynamo:0 tensorrt_llm/_torch/pyexecutor/model_engine.py ${SITE_PACKAGES}/tensorrt_llm/_torch/pyexecutor/model_engine.py
COPY --chown=dynamo:0 tensorrt_llm/_torch/pyexecutor/cuda_graph_runner.py ${SITE_PACKAGES}/tensorrt_llm/_torch/pyexecutor/cuda_graph_runner.py
COPY --chown=dynamo:0 tensorrt_llm/_torch/pyexecutor/py_executor.py ${SITE_PACKAGES}/tensorrt_llm/_torch/pyexecutor/py_executor.py
COPY --chown=dynamo:0 tensorrt_llm/_torch/pyexecutor/resource_manager.py ${SITE_PACKAGES}/tensorrt_llm/_torch/pyexecutor/resource_manager.py
COPY --chown=dynamo:0 tensorrt_llm/_torch/pyexecutor/seq_slot_manager.py ${SITE_PACKAGES}/tensorrt_llm/_torch/pyexecutor/seq_slot_manager.py
COPY --chown=dynamo:0 tensorrt_llm/_torch/pyexecutor/kv_cache_transceiver.py ${SITE_PACKAGES}/tensorrt_llm/_torch/pyexecutor/kv_cache_transceiver.py
COPY --chown=dynamo:0 tensorrt_llm/_torch/disaggregation/transceiver.py ${SITE_PACKAGES}/tensorrt_llm/_torch/disaggregation/transceiver.py
COPY --chown=dynamo:0 tensorrt_llm/_torch/disaggregation/native/peer.py ${SITE_PACKAGES}/tensorrt_llm/_torch/disaggregation/native/peer.py
COPY --chown=dynamo:0 tensorrt_llm/_torch/disaggregation/native/mixers/attention/peer.py ${SITE_PACKAGES}/tensorrt_llm/_torch/disaggregation/native/mixers/attention/peer.py
COPY --chown=dynamo:0 tensorrt_llm/_torch/pyexecutor/snapshot_hooks.py ${SITE_PACKAGES}/tensorrt_llm/_torch/pyexecutor/snapshot_hooks.py
COPY --chown=dynamo:0 tensorrt_llm/_torch/pyexecutor/_util.py ${SITE_PACKAGES}/tensorrt_llm/_torch/pyexecutor/_util.py
COPY --chown=dynamo:0 tensorrt_llm/_torch/pyexecutor/sampler.py ${SITE_PACKAGES}/tensorrt_llm/_torch/pyexecutor/sampler.py
COPY --chown=dynamo:0 tensorrt_llm/_torch/pyexecutor/guided_decoder.py ${SITE_PACKAGES}/tensorrt_llm/_torch/pyexecutor/guided_decoder.py
COPY --chown=dynamo:0 tensorrt_llm/_torch/speculative/interface.py ${SITE_PACKAGES}/tensorrt_llm/_torch/speculative/interface.py
COPY --chown=dynamo:0 tensorrt_llm/_torch/speculative/model_drafter.py ${SITE_PACKAGES}/tensorrt_llm/_torch/speculative/model_drafter.py
COPY --chown=dynamo:0 tensorrt_llm/_torch/speculative/smc.py ${SITE_PACKAGES}/tensorrt_llm/_torch/speculative/smc.py
COPY --chown=dynamo:0 tensorrt_llm/_torch/speculative/drafting_loops.py ${SITE_PACKAGES}/tensorrt_llm/_torch/speculative/drafting_loops.py
COPY --chown=dynamo:0 tensorrt_llm/_torch/model_config.py ${SITE_PACKAGES}/tensorrt_llm/_torch/model_config.py
COPY --chown=dynamo:0 tensorrt_llm/llmapi/llm_args.py ${SITE_PACKAGES}/tensorrt_llm/llmapi/llm_args.py

# Custom sparse-attention, KVarN dense-MLA, WarpDecode, request pinning, and
# MPI-control fixes carried by the op-trt rollout branch.
COPY --chown=dynamo:0 tensorrt_llm/_torch/attention_backend/trtllm.py ${SITE_PACKAGES}/tensorrt_llm/_torch/attention_backend/trtllm.py
COPY --chown=dynamo:0 tensorrt_llm/_torch/attention_backend/flashinfer.py ${SITE_PACKAGES}/tensorrt_llm/_torch/attention_backend/flashinfer.py
COPY --chown=dynamo:0 tensorrt_llm/_torch/attention_backend/triton_prefill.py ${SITE_PACKAGES}/tensorrt_llm/_torch/attention_backend/triton_prefill.py
COPY --chown=dynamo:0 tensorrt_llm/_torch/attention_backend/interface.py ${SITE_PACKAGES}/tensorrt_llm/_torch/attention_backend/interface.py
COPY --chown=dynamo:0 tensorrt_llm/_torch/attention_backend/utils.py ${SITE_PACKAGES}/tensorrt_llm/_torch/attention_backend/utils.py
COPY --chown=dynamo:0 tensorrt_llm/_torch/attention_backend/kvarn_gqa.py ${SITE_PACKAGES}/tensorrt_llm/_torch/attention_backend/kvarn_gqa.py
COPY --chown=dynamo:0 tensorrt_llm/_torch/attention_backend/sparse/dsa.py ${SITE_PACKAGES}/tensorrt_llm/_torch/attention_backend/sparse/dsa.py
COPY --chown=dynamo:0 tensorrt_llm/_torch/attention_backend/sparse/layersplit.py ${SITE_PACKAGES}/tensorrt_llm/_torch/attention_backend/sparse/layersplit.py
COPY --chown=dynamo:0 tensorrt_llm/_torch/attention_backend/sparse/kvarn_core.py ${SITE_PACKAGES}/tensorrt_llm/_torch/attention_backend/sparse/kvarn_core.py
COPY --chown=dynamo:0 tensorrt_llm/_torch/attention_backend/sparse/kvarn_backend.py ${SITE_PACKAGES}/tensorrt_llm/_torch/attention_backend/sparse/kvarn_backend.py
COPY --chown=dynamo:0 tensorrt_llm/_torch/attention_backend/sparse/kvarn_mla.py ${SITE_PACKAGES}/tensorrt_llm/_torch/attention_backend/sparse/kvarn_mla.py
COPY --chown=dynamo:0 tensorrt_llm/_torch/modules/attention.py ${SITE_PACKAGES}/tensorrt_llm/_torch/modules/attention.py
COPY --chown=dynamo:0 tensorrt_llm/_torch/modules/linear.py ${SITE_PACKAGES}/tensorrt_llm/_torch/modules/linear.py
COPY --chown=dynamo:0 tensorrt_llm/_torch/modules/gated_mlp.py ${SITE_PACKAGES}/tensorrt_llm/_torch/modules/gated_mlp.py
COPY --chown=dynamo:0 tensorrt_llm/_torch/modules/mlp.py ${SITE_PACKAGES}/tensorrt_llm/_torch/modules/mlp.py
COPY --chown=dynamo:0 tensorrt_llm/_torch/custom_ops/torch_custom_ops.py ${SITE_PACKAGES}/tensorrt_llm/_torch/custom_ops/torch_custom_ops.py
COPY --chown=dynamo:0 tensorrt_llm/_torch/auto_deploy/custom_ops/quantization/torch_quant.py ${SITE_PACKAGES}/tensorrt_llm/_torch/auto_deploy/custom_ops/quantization/torch_quant.py
COPY --chown=dynamo:0 tensorrt_llm/_torch/distributed/ops.py ${SITE_PACKAGES}/tensorrt_llm/_torch/distributed/ops.py
COPY --chown=dynamo:0 tensorrt_llm/_torch/modules/fused_moe/warp_decode.py ${SITE_PACKAGES}/tensorrt_llm/_torch/modules/fused_moe/warp_decode.py
COPY --chown=dynamo:0 tensorrt_llm/_torch/cute_dsl_kernels/blackwell/utils.py ${SITE_PACKAGES}/tensorrt_llm/_torch/cute_dsl_kernels/blackwell/utils.py
COPY --chown=dynamo:0 tensorrt_llm/_torch/pyexecutor/hang_detector.py ${SITE_PACKAGES}/tensorrt_llm/_torch/pyexecutor/hang_detector.py
COPY --chown=dynamo:0 tensorrt_llm/serve/openai_disagg_service.py ${SITE_PACKAGES}/tensorrt_llm/serve/openai_disagg_service.py
COPY --chown=dynamo:0 tensorrt_llm/serve/openai_client.py ${SITE_PACKAGES}/tensorrt_llm/serve/openai_client.py
COPY --chown=dynamo:0 tensorrt_llm/serve/openai_protocol.py ${SITE_PACKAGES}/tensorrt_llm/serve/openai_protocol.py
COPY --chown=dynamo:0 tensorrt_llm/serve/openai_server.py ${SITE_PACKAGES}/tensorrt_llm/serve/openai_server.py
COPY --chown=dynamo:0 tensorrt_llm/disaggregated_params.py ${SITE_PACKAGES}/tensorrt_llm/disaggregated_params.py
COPY --chown=dynamo:0 tensorrt_llm/executor/base_worker.py ${SITE_PACKAGES}/tensorrt_llm/executor/base_worker.py
COPY --chown=dynamo:0 tensorrt_llm/executor/proxy.py ${SITE_PACKAGES}/tensorrt_llm/executor/proxy.py
COPY --chown=dynamo:0 tensorrt_llm/executor/rpc_proxy.py ${SITE_PACKAGES}/tensorrt_llm/executor/rpc_proxy.py
COPY --chown=dynamo:0 tensorrt_llm/executor/rpc_worker_mixin.py ${SITE_PACKAGES}/tensorrt_llm/executor/rpc_worker_mixin.py
COPY --chown=dynamo:0 tensorrt_llm/executor/worker.py ${SITE_PACKAGES}/tensorrt_llm/executor/worker.py

RUN /opt/dynamo/venv/bin/python -m py_compile \
	    ${SITE_PACKAGES}/tensorrt_llm/mapping.py \
	    ${SITE_PACKAGES}/tensorrt_llm/_torch/pyexecutor/request_utils.py \
	    ${SITE_PACKAGES}/tensorrt_llm/_torch/pyexecutor/py_executor_creator.py \
	    ${SITE_PACKAGES}/tensorrt_llm/_torch/pyexecutor/model_engine.py \
	    ${SITE_PACKAGES}/tensorrt_llm/_torch/pyexecutor/cuda_graph_runner.py \
	    ${SITE_PACKAGES}/tensorrt_llm/_torch/pyexecutor/py_executor.py \
	    ${SITE_PACKAGES}/tensorrt_llm/_torch/pyexecutor/resource_manager.py \
	    ${SITE_PACKAGES}/tensorrt_llm/_torch/pyexecutor/seq_slot_manager.py \
	    ${SITE_PACKAGES}/tensorrt_llm/_torch/pyexecutor/kv_cache_transceiver.py \
	    ${SITE_PACKAGES}/tensorrt_llm/_torch/disaggregation/transceiver.py \
	    ${SITE_PACKAGES}/tensorrt_llm/_torch/disaggregation/native/peer.py \
	    ${SITE_PACKAGES}/tensorrt_llm/_torch/disaggregation/native/mixers/attention/peer.py \
	    ${SITE_PACKAGES}/tensorrt_llm/_torch/pyexecutor/snapshot_hooks.py \
		    ${SITE_PACKAGES}/tensorrt_llm/_torch/pyexecutor/_util.py \
    ${SITE_PACKAGES}/tensorrt_llm/_torch/pyexecutor/sampler.py \
    ${SITE_PACKAGES}/tensorrt_llm/_torch/pyexecutor/guided_decoder.py \
    ${SITE_PACKAGES}/tensorrt_llm/_torch/speculative/interface.py \
    ${SITE_PACKAGES}/tensorrt_llm/_torch/speculative/model_drafter.py \
    ${SITE_PACKAGES}/tensorrt_llm/_torch/speculative/smc.py \
    ${SITE_PACKAGES}/tensorrt_llm/_torch/speculative/drafting_loops.py \
	    ${SITE_PACKAGES}/tensorrt_llm/_torch/model_config.py \
	    ${SITE_PACKAGES}/tensorrt_llm/_torch/attention_backend/trtllm.py \
	    ${SITE_PACKAGES}/tensorrt_llm/_torch/attention_backend/flashinfer.py \
	    ${SITE_PACKAGES}/tensorrt_llm/_torch/attention_backend/triton_prefill.py \
	    ${SITE_PACKAGES}/tensorrt_llm/_torch/attention_backend/interface.py \
	    ${SITE_PACKAGES}/tensorrt_llm/_torch/attention_backend/utils.py \
	    ${SITE_PACKAGES}/tensorrt_llm/_torch/attention_backend/kvarn_gqa.py \
	    ${SITE_PACKAGES}/tensorrt_llm/_torch/attention_backend/sparse/dsa.py \
	    ${SITE_PACKAGES}/tensorrt_llm/_torch/attention_backend/sparse/layersplit.py \
    ${SITE_PACKAGES}/tensorrt_llm/_torch/attention_backend/sparse/kvarn_core.py \
    ${SITE_PACKAGES}/tensorrt_llm/_torch/attention_backend/sparse/kvarn_backend.py \
    ${SITE_PACKAGES}/tensorrt_llm/_torch/attention_backend/sparse/kvarn_mla.py \
    ${SITE_PACKAGES}/tensorrt_llm/_torch/modules/attention.py \
    ${SITE_PACKAGES}/tensorrt_llm/_torch/modules/linear.py \
    ${SITE_PACKAGES}/tensorrt_llm/_torch/modules/gated_mlp.py \
    ${SITE_PACKAGES}/tensorrt_llm/_torch/modules/mlp.py \
    ${SITE_PACKAGES}/tensorrt_llm/_torch/custom_ops/torch_custom_ops.py \
    ${SITE_PACKAGES}/tensorrt_llm/_torch/auto_deploy/custom_ops/quantization/torch_quant.py \
    ${SITE_PACKAGES}/tensorrt_llm/_torch/distributed/ops.py \
    ${SITE_PACKAGES}/tensorrt_llm/_torch/cute_dsl_kernels/blackwell/utils.py \
    ${SITE_PACKAGES}/tensorrt_llm/llmapi/llm_args.py \
    ${SITE_PACKAGES}/tensorrt_llm/serve/openai_disagg_service.py \
    ${SITE_PACKAGES}/tensorrt_llm/serve/openai_client.py \
    ${SITE_PACKAGES}/tensorrt_llm/serve/openai_protocol.py \
    ${SITE_PACKAGES}/tensorrt_llm/serve/openai_server.py \
    ${SITE_PACKAGES}/tensorrt_llm/disaggregated_params.py \
    ${SITE_PACKAGES}/tensorrt_llm/executor/proxy.py \
    ${SITE_PACKAGES}/tensorrt_llm/executor/rpc_worker_mixin.py \
    ${SITE_PACKAGES}/tensorrt_llm/executor/worker.py

USER dynamo
